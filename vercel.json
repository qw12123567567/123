{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node deployment/check-build.mjs",
  "outputDirectory": "public",
  "regions": ["hnd1"],
  "functions": {"api/index.mjs": {"includeFiles": "public/**", "maxDuration": 300}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index?__route=:path*"},
    {"source": "/:path*", "destination": "/index.html"}
  ],
  "headers": [{"source": "/:path*", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "X-Frame-Options", "value": "DENY"},
    {"key": "Referrer-Policy", "value": "same-origin"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'self'; frame-ancestors 'none'"}
  ]}],
  "crons": [{"path": "/api/cron", "schedule": "0 18 * * *"}]
}
